# Salin ke .env lalu sesuaikan. JANGAN commit .env.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=machine_dashboard
PORT=3000
PGDATABASE_LOOM=loom_monitor
SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- Hanya untuk docker compose --------------------------------------
# PGHOST/PGUSER/PGDATABASE di atas diabaikan saat pakai compose: compose
# menyetelnya sendiri ke container db. Yang dibaca compose dari sini:
#
#   POSTGRES_PASSWORD  sandi Postgres dibuat, dan yang dipakai aplikasi
#   SESSION_SECRET     wajib, sama seperti di atas
#   PORT               port di host
#   COOKIE_SECURE      isi 1 HANYA kalau lewat HTTPS
POSTGRES_PASSWORD=ganti-sandi-ini
COOKIE_SECURE=

# Alamat yang dilayani Caddy.
#   dashboard.contoh.com  -> HTTPS otomatis (domain harus sudah mengarah ke VPS)
#   103.150.20.44         -> HTTPS langsung ke IP VPS, sebelum ada domain
#   :80                   -> http polos, bawaan
# Setelah HTTPS jalan (domain atau IP), isi COOKIE_SECURE=1 di atas.
SITE_ADDRESS=:80
